# -------------------------
# Python default
# -------------------------
__pycache__/
*.py[codz]
*$py.class
*.so

# -------------------------
# Build / packaging default
# -------------------------
build/
dist/
*.egg-info/
.eggs/
*.egg

# -------------------------
# Jupyter default
# -------------------------
.ipynb_checkpoints/

# -------------------------
# Virtual environments
# DLAvenv is our local environment for the course.
# -------------------------
DLAvenv/
.venv/
venv/
env/

# -------------------------
# Editor / OS files
# Local editor settings and macOS/Windows metadata.
# -------------------------
.vscode/
.DS_Store
Thumbs.db

# -------------------------
# Weights & Biases
# Local W&B logs; the useful results are online.
# -------------------------
wandb/

# -------------------------
# Datasets
# Large downloaded datasets should not be committed.
# -------------------------
data/
_data/

# -------------------------
# RL checkpoints
# Keep the folder structure, ignore saved model weights.
# -------------------------
lab3/checkpoints/*
!lab3/checkpoints/.gitkeep
*.pt
*.pth

# -------------------------
# Cache / test tools default
# -------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/